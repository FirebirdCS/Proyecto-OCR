# ---- Server ----
NODE_ENV=development
PORT=4000
# Origins allowed to call the API, comma-separated (scheme + host + port only).
# e.g. http://localhost:5173,https://<user>.github.io
CLIENT_ORIGIN=http://localhost:5173
# Where the app is published, including any sub-path. Used for invite links.
# e.g. https://<user>.github.io/Proyecto-OCR — empty means the first origin above.
CLIENT_APP_URL=
# Shown in invite emails.
APP_NAME=OCR Platform

# ---- Firebase Admin ----
# Option A (recommended locally): path to the service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Option B (recommended for hosting): inline the service account fields.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes when pasting the private key on one line.
FIREBASE_PRIVATE_KEY=
# Only needed if you use the Realtime Database instead of / alongside Firestore.
FIREBASE_DATABASE_URL=

# ---- Roles ----
# Comma-separated emails promoted to "admin" the first time they sign in.
# Everyone else starts as "user". You can also run: pnpm role:grant <email> admin
BOOTSTRAP_ADMIN_EMAILS=

# ---- OCR (Google Cloud Vision) ----
# Reuses the Firebase service account above unless you set a dedicated one.
VISION_KEY_FILE=
# Max upload size accepted by the OCR endpoint, in megabytes.
OCR_MAX_UPLOAD_MB=10

# ---- Admin dashboard ----
# IANA time zone that decides which calendar day a sale belongs to
# (e.g. America/Mexico_City). Empty means the server's own zone.
STATS_TIME_ZONE=

# ---- Receipt review & abuse limits ----
# Bucket that keeps every scanned file as evidence (Firebase console > Storage).
# Empty means files are not kept and admins review text only.
FIREBASE_STORAGE_BUCKET=
# Scans one user may send in any rolling 24 hours (rejected ones count too).
SCAN_DAILY_LIMIT=20
# Units one receipt may count in a campaign; the excess is dropped and flagged.
RECEIPT_MAX_UNITS=50

# ---- SMTP ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OCR Platform <no-reply@example.com>"

# ---- Resend (credentials email) ----
RESEND_API_KEY=
RESEND_FROM="CORVELSA <info@corvelsa.com>"
