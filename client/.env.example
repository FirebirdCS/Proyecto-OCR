# Firebase Web SDK config — Project settings > Your apps > Web app.
# Every VITE_* value is bundled into the client, so keep secrets out of here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Only if you enabled Google Analytics on the project.
VITE_FIREBASE_MEASUREMENT_ID=
# Only for the Realtime Database.
VITE_FIREBASE_DATABASE_URL=

# Leave empty to use the Vite dev proxy at /api.
VITE_API_BASE_URL=
